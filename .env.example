# Smart FAQ Chatbot - environment configuration
# Copy this file to `.env` and fill in the values you need.
# Without any key the chatbot still runs in offline demo mode.

# Which backend to use: auto | openai | ollama | huggingface | demo
LLM_PROVIDER=auto

# Your institute name (appears in the assistant's persona)
COLLEGE_NAME=ABC Institute of Technology

# --- Option A: OpenAI (https://platform.openai.com/api-keys) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Option B: HuggingFace Inference API (free token: https://huggingface.co/settings/tokens) ---
HF_TOKEN=
HUGGINGFACE_MODEL=meta-llama/Llama-3.1-8B-Instruct

# --- Option C: Ollama (local & free: https://ollama.com, then `ollama pull llama3.2`) ---
OLLAMA_MODEL=llama3.2
